# Gemini API Key (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Client Configuration (Public/Client-Safe)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Admin Service Account (Optional for Local Server Verify, fallback uses client auth tokens)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Syndication Feed Secret Token (Used by external Manus automation agent)
SYNDICATION_SECRET_TOKEN=newsengine_manus_syndication_secret_key_2026

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Live TV player: configure one or both depending on the provider
NEXT_PUBLIC_LIVE_STREAM_EMBED_URL=
NEXT_PUBLIC_LIVE_STREAM_URL=
NEXT_PUBLIC_OFFICIAL_LIVE_URL=https://zeenews.india.com/live-tv

# Automated RSS scheduler protection
CRON_SECRET=

# Optional custom RSS feeds. Format: Name|URL|category, separated by commas.
NEWS_RSS_URLS=
