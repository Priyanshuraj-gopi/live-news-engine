rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isContributor() {
      return hasRole('contributor') || isEditor() || isAdmin();
    }
    
    function isEditor() {
      return hasRole('editor') || isAdmin();
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    // 1. Users collection
    // Anyone can read basic public profile; user can read/update their own profile; admin can manage
    match /users/{userId} {
      allow read: if true; // Public reader credibility & profile view
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Stories collection
    // Anyone can read published stories (guests allowed); contributors can draft; editors & admins can publish/modify
    match /stories/{storyId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create: if isContributor();
      allow update: if isEditor() || (isContributor() && resource.data.author.id == request.auth.uid && resource.data.status == 'draft');
      allow delete: if isAdmin();

      // Subcollection: storyVersions
      match /versions/{lang} {
        allow read: if true;
        allow write: if isEditor();
      }
    }

    // 3. User Signals (recommendation events, dwell time, clicks)
    // Authenticated users or guest users with assigned signal session can write; user can read their own; admin can read all
    match /userSignals/{signalId} {
      allow create: if true; // Allow anonymous/guest readers to log signals
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 4. Live Debates / Chat per story: chats/{storyId}/messages/{messageId}
    // Anyone can read approved messages; authenticated users can post message (guest reading allowed, posting requires auth)
    match /chats/{storyId}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) || isEditor();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isEditor();
    }

    // 5. Credibility profiles
    // Public read for badges/ranks; updates only allowed via system/server or admin
    match /credibility/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['overallScore', 'level']));
      allow delete: if isAdmin();
    }

    // 6. Contributor Uploads
    // Contributors can submit drafts; editors can review/approve; admins have full access
    match /uploads/{uploadId} {
      allow read: if isEditor() || (isAuthenticated() && resource.data.author.id == request.auth.uid);
      allow create: if isContributor() && request.resource.data.author.id == request.auth.uid;
      allow update: if isEditor() || (isContributor() && resource.data.author.id == request.auth.uid && resource.data.status == 'draft');
      allow delete: if isAdmin() || (isContributor() && resource.data.author.id == request.auth.uid && resource.data.status == 'draft');
    }

    // 7. Admin Insights & Content Intelligence
    // Editors and Admins only
    match /adminInsights/{insightId} {
      allow read, write: if isEditor();
    }
  }
}
